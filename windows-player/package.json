{
  "name": "knk-signage-player",
  "version": "1.0.6",
  "private": true,
  "description": "Vamtratech offline-capable Windows digital signage player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vamtratech.knksignage",
    "productName": "Vamtratech Signage Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "player.html",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vamtratech Signage Player"
    }
  }
}